# Cloudflare static-asset cache policy (Workers honours _headers, same as Pages).
#
# Everything here is either content-hashed by Vite (/assets/*) or has a stable,
# content-addressed filename (card art, fonts, sounds), so it can be cached for a
# year and served immutable. index.html is intentionally left out so the SPA shell
# (and its references to the current hashed bundles) is always revalidated.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/cards/*
  Cache-Control: public, max-age=31536000, immutable

/cards-bg/*
  Cache-Control: public, max-age=31536000, immutable

/sounds/*
  Cache-Control: public, max-age=31536000, immutable
