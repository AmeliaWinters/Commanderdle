# Copy to `.env` (or set in the Cloudflare Pages dashboard) and fill per deploy.
# All are optional — the app runs without them; the related feature just stays off.

# Canonical site origin, no trailing slash. Used for canonical/OG URLs.
VITE_SITE_URL=https://commandle.com

# Google AdSense. Ads only render when BOTH are set to real values.
VITE_ADSENSE_PUB_ID=
VITE_ADSENSE_SLOT_ID=

# Analytics measurement id (e.g. GA4 "G-XXXXXXX"). Analytics stays off when unset.
VITE_ANALYTICS_ID=
